{
  "name": "arara-vibes",
  "version": "0.1.0",
  "description": "Floating AI desktop companion powered by Arara AI",
  "author": "Arara <contato@arara.code.app.br>",
  "license": "Apache-2.0",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "env -u ELECTRON_RUN_AS_NODE electron . --smoke-test",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "package": "electron-builder --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "br.app.code.arara.vibes",
    "productName": "Arara Vibes",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "media/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "maintainer": "Arara <contato@arara.code.app.br>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
