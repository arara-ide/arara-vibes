{
  "name": "arara-vibes",
  "version": "0.1.0",
  "description": "Floating AI desktop companion powered by Arara AI",
  "author": "Arara <contato@arara.code.app.br>",
  "license": "Apache-2.0",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/start.test.mjs scripts/sign-macos.test.mjs scripts/package.test.mjs scripts/store.test.mjs",
    "test:smoke": "env -u ELECTRON_RUN_AS_NODE electron . --smoke-test",
    "test:shell": "node scripts/test-shell.mjs",
    "test:surfaces": "node scripts/test-mac-surfaces.mjs",
    "test:transport": "node scripts/test-shell.mjs --transport",
    "test:updates": "node scripts/test-shell.mjs --updates",
    "test:autostart:mac": "node scripts/test-macos-autostart.mjs",
    "test:autostart:runtime": "node scripts/test-login-runtime.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:tabs": "node scripts/test-tab-drag.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "start": "node scripts/start.mjs",
    "package": "node scripts/package.mjs",
    "package:mac": "node scripts/package.mjs --mac",
    "package:win": "node scripts/package.mjs --win",
    "package:linux": "node scripts/package.mjs --linux",
    "preview": "node dist/preview.mjs",
    "build:icons": "node scripts/build-icons.cjs"
  },
  "build": {
    "appId": "br.app.code.arara.vibes",
    "productName": "Arara Vibes",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "dist/companion.cjs",
      "dist/renderer.js",
      "dist/index.html",
      "dist/shell.css",
      "dist/tokens.css",
      "dist/logo.svg",
      "dist/logo-white.svg",
      "dist/logo-animated.svg",
      "dist/tray-white.png",
      "dist/tray-white@2x.png",
      "dist/icon.png",
      "package.json",
      "dist/icons.svg",
      "dist/codicons-LICENSE"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "sign": "scripts/sign-macos.cjs",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "maintainer": "Arara <contato@arara.code.app.br>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "artifactName": "AraraVibes-${os}-${arch}-${version}.${ext}",
    "icon": "build/icon.png"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "homepage": "https://arara.code.app.br"
}
