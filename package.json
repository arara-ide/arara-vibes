{
  "name": "arara-vibes",
  "version": "0.1.0",
  "description": "Floating AI desktop companion powered by Arara AI",
  "author": "Arara <contato@arara.code.app.br>",
  "license": "Apache-2.0",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/start.test.mjs scripts/sign-macos.test.mjs",
    "test:smoke": "env -u ELECTRON_RUN_AS_NODE electron . --smoke-test",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "start": "node scripts/start.mjs",
    "package": "electron-builder --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never",
    "preview": "node dist/preview.mjs"
  },
  "build": {
    "appId": "br.app.code.arara.vibes",
    "productName": "Arara Vibes",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.cjs",
      "dist/companion.cjs",
      "dist/renderer.js",
      "dist/index.html",
      "dist/shell.css",
      "dist/tokens.css",
      "dist/logo.svg",
      "dist/logo-white.svg",
      "dist/tray.png",
      "package.json",
      "dist/icons.svg",
      "dist/codicons-LICENSE"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "sign": "scripts/sign-macos.cjs"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "maintainer": "Arara <contato@arara.code.app.br>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "artifactName": "AraraVibes-${os}-${arch}-${version}.${ext}"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
